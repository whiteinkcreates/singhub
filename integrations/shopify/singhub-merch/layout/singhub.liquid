<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#06090e">
    <title>{{ page_title | escape }} | SingHUB Merch Table</title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet">
    {{ content_for_header }}
    {{ 'singhub-merch.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'singhub-merch.js' | asset_url }}" defer></script>
  </head>
  <body class="sh-merch-body">
    <a class="sh-skip" href="#merch-main">Skip to the Merch Table</a>
    {{ content_for_layout }}
  </body>
</html>
